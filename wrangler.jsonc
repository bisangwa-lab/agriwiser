{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agriwiser",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.js",
  "d1_databases": [
    {
      "binding": "LOCAL_AUTH_DB",
      "database_name": "hingasmart-local-auth",
      "database_id": "9dfdc651-70d2-4487-b0e2-f0658eacec76",
      "migrations_dir": "migrations"
    }
  ]
}
