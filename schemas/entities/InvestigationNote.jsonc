{
  "name": "InvestigationNote",
  "type": "object",
  "properties": {
    "investigation_id": {
      "type": "string"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "note",
        "field_observation",
        "evidence",
        "unresolved_question",
        "source_check"
      ]
    },
    "content": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "observed_on": {
      "type": "string",
      "format": "date"
    },
    "is_demo": {
      "type": "boolean"
    }
  },
  "required": [
    "investigation_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}